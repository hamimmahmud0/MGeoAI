# Copy to .env (never commit it). Everything here is read from the environment.
# Data directory of the workspace (articles, labels, model runs, matching results)
MGEOAI_EXTRACTION_DIR=extraction
# Required to sign in: at least 32 random characters
MGEOAI_SESSION_SECRET=
# Set to true when the site is served over HTTPS
MGEOAI_SECURE_COOKIES=false
# Provider keys. These can also be pasted into the control panel (kept in server memory only).
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# A self-hosted OpenAI-compatible server (for example llama.cpp)
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
# Hugging Face token (only for the backup worker and for uploading the dataset)
HF_TOKEN=
