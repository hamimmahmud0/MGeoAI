{
  "$defs": {
    "AssertionType": {
      "enum": [
        "observed",
        "reported",
        "attributed_claim",
        "opinion",
        "inferred",
        "predicted"
      ],
      "title": "AssertionType",
      "type": "string"
    },
    "ProvenanceLocator": {
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block Id"
        },
        "locator": {
          "title": "Locator",
          "type": "string"
        },
        "locator_type": {
          "enum": [
            "html_selector",
            "json_path",
            "video_timestamp",
            "image_region",
            "source"
          ],
          "title": "Locator Type",
          "type": "string"
        },
        "original_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Text"
        },
        "source_path": {
          "title": "Source Path",
          "type": "string"
        }
      },
      "required": [
        "source_path",
        "locator_type",
        "locator"
      ],
      "title": "ProvenanceLocator",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assertion_type": {
      "$ref": "#/$defs/AssertionType"
    },
    "assumptions": {
      "items": {
        "type": "string"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "casualty_quantities": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Casualty Quantities",
      "type": "object"
    },
    "claim_text": {
      "title": "Claim Text",
      "type": "string"
    },
    "claimant": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Claimant"
    },
    "claimant_role": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Claimant Role"
    },
    "entities": {
      "items": {
        "type": "string"
      },
      "title": "Entities",
      "type": "array"
    },
    "evidence_id": {
      "title": "Evidence Id",
      "type": "string"
    },
    "evidence_kind": {
      "title": "Evidence Kind",
      "type": "string"
    },
    "extensions": {
      "additionalProperties": true,
      "title": "Extensions",
      "type": "object"
    },
    "extraction_confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Extraction Confidence",
      "type": "number"
    },
    "location_mentions": {
      "items": {
        "type": "string"
      },
      "title": "Location Mentions",
      "type": "array"
    },
    "modality": {
      "enum": [
        "text",
        "image",
        "video",
        "audio"
      ],
      "title": "Modality",
      "type": "string"
    },
    "normalized_claim": {
      "title": "Normalized Claim",
      "type": "string"
    },
    "object": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Object"
    },
    "predicate": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Predicate"
    },
    "provenance": {
      "$ref": "#/$defs/ProvenanceLocator"
    },
    "road_users": {
      "items": {
        "type": "string"
      },
      "title": "Road Users",
      "type": "array"
    },
    "source_id": {
      "title": "Source Id",
      "type": "string"
    },
    "source_support": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Support"
    },
    "subject": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Subject"
    },
    "time_mentions": {
      "items": {
        "type": "string"
      },
      "title": "Time Mentions",
      "type": "array"
    },
    "traffic_effects": {
      "items": {
        "type": "string"
      },
      "title": "Traffic Effects",
      "type": "array"
    },
    "vehicles": {
      "items": {
        "type": "string"
      },
      "title": "Vehicles",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "evidence_id",
    "source_id",
    "modality",
    "evidence_kind",
    "assertion_type",
    "claim_text",
    "normalized_claim",
    "provenance",
    "extraction_confidence"
  ],
  "title": "EvidenceItem",
  "type": "object"
}
